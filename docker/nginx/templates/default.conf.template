# Server internal polos (HTTP saja) — container ini TIDAK menghadap internet
# langsung. SSL, domain, dan routing publik diurus "npm" (Nginx Proxy
# Manager) yang proxy ke container ini lewat network Docker (nginx:80).

server {
    listen 80;
    server_name _;

    root /var/www/html/public;
    index index.php;

    client_max_body_size 8m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # Container ini cuma diakses lewat NPM (yang sudah terminate SSL),
        # tidak pernah langsung dari publik — jadi request yang sampai sini
        # selalu "sebenarnya" HTTPS meski koneksi NPM->nginx polos HTTP.
        # Tanpa ini Laravel generate URL asset (Vite) pakai http://, kena
        # blokir mixed-content oleh browser.
        fastcgi_param HTTPS on;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
